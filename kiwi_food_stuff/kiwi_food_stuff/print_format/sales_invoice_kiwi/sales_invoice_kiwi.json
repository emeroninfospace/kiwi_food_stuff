 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Tax Invoice</title>\n    <style>\n        @page {\n            margin: 10mm;\n            size: A4;\n        }\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        body {\n            font-family: Arial, sans-serif;\n            font-size: 10pt;\n            line-height: 1.3;\n            background: #fff;\n            color: #222;\n        }\n        .invoice-container {\n            width: 100%;\n            border: 1px solid #000;\n            background: #fff;\n        }\n        .header-section {\n            border-bottom: 1.5px solid #000;\n            padding: 2px;\n            overflow: hidden;\n        }\n        .header-section table {\n            width: 100%;\n            border-collapse: collapse;\n        }\n        .logo-cell {\n            width: 180px;\n            vertical-align: top;\n            padding-right: 12px;\n        }\n        .logo-cell img {\n            width: 160px;\n            max-width: 100%;\n            height: auto;\n            display: block;\n        }\n        .letter-head {\n            width: 100%;\n            max-width: 160px;\n        }\n        .letter-head img {\n            width: 100%;\n            height: auto;\n            display: block;\n        }\n        .company-info-cell {\n            text-align: left;\n            vertical-align: top;\n        }\n        .company-name {\n            font-size: 14pt;\n            font-weight: bold;\n            color: #137a2d;\n            margin-bottom: 4px;\n            width: max-content;\n        }\n        .company-details {\n            font-size: 7pt;\n            line-height: 1.5;\n        }\n        .arabic-cell {\n            width: 250px;\n            text-align: right;\n            direction: rtl;\n            font-size: 15pt;\n            font-weight: bold;\n            color: #137a2d;\n            vertical-align: top;\n        }\n        .title-section {\n            text-align: center;\n            padding: 4px 0;\n            font-weight: bold;\n            font-size: 11pt;\n            border-bottom: 1.5px solid #000;\n            letter-spacing: 0.5px;\n        }\n        .invoice-info {\n           \n        }\n        .invoice-info table {\n            width: 100%;\n            border-collapse: collapse;\n        }\n        .invoice-info td {\n            padding: 8px 12px 4px 10px;\n            font-size: 9pt;\n            vertical-align: top;\n        }\n        .left-col {\n            width: 52%;\n            border-right: 1px solid #000;\n        }\n        .right-col {\n            width: 48%;\n        }\n        .info-label {\n            display: inline-block;\n            min-width: 98px;\n          \n        }\n        .arabic-label {\n            direction: rtl;\n            font-size: 8pt;\n            color: #555;\n            margin-left: 10px;\n        }\n        /* Items Table */\n        .items-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 0;\n        }\n        .items-table th, .items-table td {\n            border: 1px solid #222;\n        }\n        .items-table th {\n            padding: 7px 2px 4px 2px;\n            text-align: center;\n         \n            font-size: 9pt;\n        }\n        .items-table td {\n            padding: 6px 2px;\n            text-align: center;\n            font-size: 9pt;\n        }\n        .items-table .text-left {\n            text-align: left;\n            padding-left: 8px;\n        }\n        .items-table .col-sr { width: 7%;color: #0e0e0e; }\n        .items-table .col-product { width: 51%;color: #0e0e0e; }\n        .items-table .col-qty { width: 6%;color: #0e0e0e; }\n        .items-table .col-unit { width: 6%;color: #0e0e0e; }\n        .items-table .col-rate { width: 9%;color: #0e0e0e; }\n        .items-table .col-gross { width: 13%;color: #0e0e0e; }\n        .items-table .col-vat { width: 10%;color: #0e0e0e; }\n        .items-table .col-amount { width: 12%;color: #0e0e0e; }\n        .arabic-header {\n            display: block;\n            direction: rtl;\n            font-size: 7pt;\n            color: #272727;\n            font-weight: normal;\n        }\n        /* Empty row styling */\n        .items-table .empty-row td {\n            height: 28px;\n            color: transparent;\n            border-left: none;\n            border-right: 1px solid black;\n            border-top: none;\n            border-bottom: none;\n        }\n        /* Summary Section */\n        .summary-section {\n            border-top: 0;\n            font-size: 9pt;\n        }\n        .summary-section table {\n            width: 100%;\n            border-collapse: collapse;\n        }\n        .summary-section td {\n            vertical-align: top;\n            padding: 14px 10px 8px 10px;\n        }\n        .summary-left {\n            width: 50%;\n            border-right: 1.5px dotted #000;\n        }\n        .summary-right {\n            width: 50%;\n        }\n        .total-qty-row {\n            margin-bottom: 12px;\n            font-size: 11px;\n            \n            \n           \n        }\n        .total-qty-value {\n            margin-left: 8px;\n            font-weight: normal;\n        }\n        .narration-box {\n            margin: 10px 0 0 0;\n            font-size: 8pt;\n            min-height: 30px;\n            color: #333;\n        }\n        .amount-words-box {\n            margin: 14px 0 0 0;\n            font-size: 11px;\n            color: #222;\n            min-height: 22px;\n        }\n        .summary-row {\n            margin-bottom: 7px;\n            font-size: 8pt;\n        }\n       \n        .summary-value {\n            float: right;\n            min-width: 75px;\n            text-align: right;\n            font-weight: bold;\n        }\n        .grand-total-row {\n            border-top: 1px dotted #444;\n            font-size: 12pt;\n           \n            color: #343835;\n            padding-top: 8px;\n            margin-top: 8px;\n        }\n        /* Footer Section */\n        .footer-section {\n            border-top: 1px dotted #000;\n            margin-top: 2px;\n        }\n        .footer-section table {\n            width: 100%;\n            border-collapse: collapse;\n        }\n        .footer-section td {\n            font-size: 9pt;\n            text-align: center;\n            padding: 15px 0;\n            border-right: 1px dotted #444;\n            vertical-align: top;\n        }\n        .footer-section td:last-child {\n            border-right: none;\n        }\n        .footer-label {\n          \n            margin-bottom: 33px;\n            display: block;\n        }\n        .footer-arabic {\n            direction: rtl;\n            font-size: 8pt;\n            color: #666;\n        }\n        .print-format td, .print-format th {\n            padding: 5px !important;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"invoice-container\">\n        <!-- Header Section -->\n        <div class=\"header-section\">\n            <table>\n                <tr>\n                   <td class=\"logo-cell\" style=\"width: 26%; vertical-align: top;\">\n            {% if letter_head %}\n                <div class=\"letter-head\" style=\"margin-bottom: 0px;\">\n                    {{ letter_head }}\n                </div>\n            {% endif %}\n        </td>\n                    <!-- Company Info Cell -->\n                    <td class=\"company-info-cell\">\n                        <div class=\"company-name\">KIWI FOODSTUFF TRADING L.L.C</div>\n                        <div class=\"company-details\">\n                            DUBAI, UNITED ARAB EMIRATES<br>\n                            WWW.KIWIFOODSTUFF.COM<br>\n                            <strong>Phone:</strong> +971 542667954<br>\n                            <strong>Email Id:</strong> info@kiwifoodstuff.com<br>\n                            <strong>VAT/TRN No:</strong> <b>104687715300003</b> \n                        </div>\n                    </td>\n                    <!-- Arabic Company Name Cell -->\n                    <td class=\"arabic-cell\" style=\"width: 43%;\">\n                        \u0643\u064a\u0648\u064a \u0644\u062a\u062c\u0627\u0631\u0629 \u0627\u0644\u0645\u0648\u0627\u062f \u0627\u0644\u063a\u0630\u0627\u0626\u064a\u0629 \u0630.\u0645.\u0645\n                    </td>\n                </tr>\n            </table>\n        </div>\n        <!-- Title Section -->\n        <div class=\"title-section\">\n            Tax Invoice ( \u0641\u0627\u062a\u0648\u0631\u0629 \u0636\u0631\u064a\u0628\u064a\u0629 )\n        </div>\n        <!-- Invoice Info Section -->\n        <div class=\"invoice-info\">\n            <table>\n                <tr>\n                    <td class=\"left-col\">\n                        <span class=\"info-label\">Invoice No :</span>\n                        <b><span>{{ doc.name }}</span></b>\n                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<b><span class=\"arabic-label\">: \u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</span></b>\n                    </td>\n                    <td class=\"right-col\">\n                        <span class=\"info-label\">Invoice Date:</span>\n                        <span>{{ doc.get_formatted(\"posting_date\") }}</span>\n        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<b><span class=\"arabic-label\">: \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</span></b>\n                    </td>\n                </tr>\n                <tr>\n                    <td class=\"left-col\">\n                        <div style=\"margin-bottom:6px;\">\n                            <span class=\"info-label\">Customer :</span>\n                            <span>{{ doc.customer_name }}</span>\n                        </div>\n                        <div style=\"margin-bottom:6px;\">\n                            <span class=\"info-label\">Address :</span>\n                            <span>{{ doc.address_display or '' }}</span>\n                        </div>\n                    </td>\n                    <td class=\"right-col\">\n                        <div style=\"margin-bottom:6px;\">\n                            <span class=\"info-label\">Cust. VAT No :</span>\n                            <span>{{ doc.tax_id or '' }}</span>\n                        </div>\n                        <div style=\"margin-bottom:6px;\">\n                            <span class=\"info-label\">Quotation No :</span>\n                            <span></span>\n                        </div>\n                        <div style=\"margin-bottom:6px;\">\n                            <span class=\"info-label\">P\u0648 No :</span>\n                            <span>{{ doc.po_no or '/' }}</span>\n                        </div>\n                        <div style=\"margin-bottom:6px;\">\n                            <span class=\"info-label\">Ref. No :</span>\n                            <span>{{ doc.customer_purchase_order or '' }}</span>\n                        </div>\n                    </td>\n                </tr>\n            </table>\n        </div>\n        <!-- Items Table -->\n        <table class=\"items-table\">\n            <thead>\n                <tr>\n                    <th class=\"col-sr\">Sr #<span class=\"arabic-header\">\u0631\u0642\u0645 \u0633\u0631\u064a</span></th>\n                    <th class=\"col-product\">Product Name<span class=\"arabic-header\">\u0627\u0633\u0645 \u0627\u0644\u0645\u0646\u062a\u062c</span></th>\n                    <th class=\"col-qty\">Qty<span class=\"arabic-header\">\u0643\u0645\u064a\u0629</span></th>\n                    <th class=\"col-unit\">Unit<span class=\"arabic-header\">\u0648\u062d\u062f\u0629</span></th>\n                    <th class=\"col-rate\">Rate<span class=\"arabic-header\">\u0645\u0639\u062f\u0644</span></th>\n                    <th class=\"col-gross\">Gross Amt<span class=\"arabic-header\">\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u062c\u0645\u0627\u0644\u064a</span></th>\n                    <th class=\"col-vat\">VAT 5.00%<span class=\"arabic-header\">\u0636\u0631\u064a\u0628\u0629</span></th>\n                    <th class=\"col-amount\">Amount<span class=\"arabic-header\">\u0643\u0645\u064a\u0629</span></th>\n                </tr>\n            </thead>\n            <tbody>\n                <!-- Actual Items -->\n                {% for item in doc.items %}\n                <tr style=\"border-bottom:   dotted #d6d6d6\">\n                    <td class=\"col-sr\">{{ loop.index }}</td>\n                    <td class=\"col-product text-left\">{{ item.item_name or item.item_code }}</td>\n                    <td class=\"col-qty\">{{ \"%.0f\"|format(item.qty) }}</td>\n                    <td class=\"col-unit\">{{ item.uom }}</td>\n                    <td class=\"col-rate\">{{ \"%.2f\"|format(item.rate) }}</td>\n                    <td class=\"col-gross\">{{ \"%.2f\"|format(item.qty * item.rate) }}</td>\n                    <td class=\"col-vat\">{{ \"%.2f\"|format((item.qty * item.rate) * 0.05) }}</td>\n                    <td class=\"col-amount\">{{ \"%.2f\"|format(item.amount) }}</td>\n                </tr>\n                {% endfor %}\n                \n                <!-- Empty Rows to Fill Space (Minimum 15 total rows) -->\n                {% set min_rows = 15 %}\n                {% set current_rows = doc.items|length %}\n                {% if current_rows < min_rows %}\n                    {% for i in range(current_rows, min_rows) %}\n                    <tr class=\"empty-row\">\n                        <td class=\"col-sr\">&nbsp;</td>\n                        <td class=\"col-product text-left\">&nbsp;</td>\n                        <td class=\"col-qty\">&nbsp;</td>\n                        <td class=\"col-unit\">&nbsp;</td>\n                        <td class=\"col-rate\">&nbsp;</td>\n                        <td class=\"col-gross\">&nbsp;</td>\n                        <td class=\"col-vat\">&nbsp;</td>\n                        <td class=\"col-amount\">&nbsp;</td>\n                    </tr>\n                    {% endfor %}\n                {% endif %}\n            </tbody>\n        </table>\n        <!-- Summary Section -->\n        <div class=\"summary-section\" style=\"border-top: groove;\">\n            <table>\n                <tr>\n                    <td class=\"summary-left\">\n                        <div class=\"total-qty-row\">\n                            Total Qty (\u0627\u0644\u0643\u0645\u064a\u0629 \u0627\u0644\u062c\u0645\u0627\u0644\u064a\u0629): \n                            <span class=\"total-qty-value\">\n                               {{ doc.total_qty }}\n                            </span>\n                        </div>\n                        <div class=\"narration-box\">\n                            Narration: <span style=\"direction:rtl;font-size:8pt;color:#666;\">\u0631\u0648\u0627\u064a\u0629</span><br>\n                            {{ doc.remarks or '' }}\n                        </div>\n                        <div class=\"amount-words-box\">\n                            Amount in words:<span style=\"direction:rtl;font-size:8pt;color:#666;\">\u0627\u0644\u0645\u0628\u0644\u063a \u0641\u064a \u0627\u0644\u0643\u0644\u0645\u0627\u062a</span><br>\n                            {{ frappe.utils.money_in_words(doc.grand_total, doc.currency) }}\n                        </div>\n                    </td>\n                    <td class=\"summary-right\">\n                        <div class=\"summary-row\">\n                            <span class=\"summary-label\">Net Value \n                                <span style=\"direction:rtl;font-size:8pt;color:#666;\">\n                                    \u0635\u0627\u0641\u064a \u0627\u0644\u0642\u064a\u0645\u0629\n                                </span> :\n                            </span>\n                            <span class=\"summary-value\">{{ \"%.2f\"|format(doc.net_total) }}</span>\n                        </div>\n                        <div class=\"summary-row\">\n                            <span class=\"summary-label\">VAT 5.00%(%) on Bill \n                                <span style=\"direction:rtl;font-size:8pt;color:#666;\">\n                                    \u0636\u0631\u064a\u0628\u0629 \u0639\u0644\u0649 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629\n                                </span> :\n                            </span>\n                            <span class=\"summary-value\">{{ \"%.2f\"|format(doc.total_taxes_and_charges) }}</span>\n                        </div>\n                        <div class=\"summary-row\">\n                            <span class=\"summary-label\">Net Amount \n                                <span style=\"direction:rtl;font-size:8pt;color:#666;\">\n                                    \u0643\u0645\u064a\u0629 \u0627\u0644\u0634\u0628\u0643\u0629\n                                </span> :\n                            </span>\n                            <span class=\"summary-value\">{{ \"%.2f\"|format(doc.grand_total) }}</span>\n                        </div>\n                        <div class=\"summary-row\">\n                            <span class=\"summary-label\">Bill Discount \n                                <span style=\"direction:rtl;font-size:8pt;color:#666;\">\n                                    \u062e\u0635\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629\n                                </span> :\n                            </span>\n                            <span class=\"summary-value\">{{ \"%.2f\"|format(doc.discount_amount or 0.00) }}</span>\n                        </div>\n                        <div class=\"summary-row grand-total-row\">\n                            <span class=\"summary-label\">Grand Total \n                                <span style=\"direction:rtl;font-size:9pt;color:#666;\">\n                                    \u0627\u0644\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0643\u0644\u064a\n                                </span>:\n                            </span>\n                            <span class=\"summary-value\">{{ \"%.2f\"|format(doc.rounded_total) }}</span>\n                        </div>\n                    </td>\n                </tr>\n            </table>\n        </div>\n        <!-- Footer Section -->\n        <div class=\"footer-section\">\n            <table>\n                <tr>\n                     <td style=\"width: 24%;\">\n                        <span class=\"footer-label\"></span>\n                        <div class=\"footer-arabic\"></div>\n                    </td>\n                    <td style=\"border-right: hidden;\">\n                        <span class=\"footer-label\">Prepared By :</span>\n                        <div class=\"footer-arabic\">\u0623\u0639\u062f\u062a \u0628\u0648\u0627\u0633\u0637\u0629</div>\n                    </td>\n                    <td style=\"border-right: hidden;\">\n                        <span class=\"footer-label\">Delivered By :</span>\n                        <div class=\"footer-arabic\">\u0633\u0644\u0645\u062a \u0628\u0648\u0627\u0633\u0637\u0629</div>\n                    </td>\n                    <td>\n                        <span class=\"footer-label\">Received By :</span>\n                        <div class=\"footer-arabic\">\u0627\u0633\u062a\u0644\u0645\u062a \u0645\u0646 \u0642\u0628\u0644</div>\n                    </td>\n                </tr>\n            </table>\n        </div>\n    </div>\n</body>\n</html>",
